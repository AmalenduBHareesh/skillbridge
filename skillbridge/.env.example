# Copy this to .env and fill in your values
# Never commit .env to git

# PostgreSQL connection string from Neon (or any managed Postgres)
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://user:password@host:5432/skillbridge

# Secret key used to sign JWTs — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-here

# Algorithm for JWT signing (keep as HS256 unless you have a reason to change)
ALGORITHM=HS256

# Standard token expiry in minutes (24 hours = 1440)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Monitoring Officer scoped token expiry in minutes (1 hour = 60)
MONITORING_TOKEN_EXPIRE_MINUTES=60

# Hardcoded API key for the Monitoring Officer extra auth layer
# In real life this would be rotated regularly
MONITORING_API_KEY=monitoring-secret-api-key-2024
